---
import TopRow from './TopRow.astro';
interface Props { eyebrow?: string; title: string; intro?: string }
const { eyebrow, title, intro } = Astro.props;
const current = Astro.url.pathname.replace(/\.html$/, '');
---
<header class="page-head">
  <div class="wrap">
    <div class="block block-sage ph reveal">
      <TopRow current={current} />
      <svg class="ph-plant" viewBox="0 0 200 220" aria-hidden="true">
        <path class="grow" d="M150 220 C 146 170, 160 130, 148 80" fill="none" stroke="#4E8B3A" stroke-width="4" stroke-linecap="round" />
        <path class="bud" style="--gd:1.4s" d="M150 170 C 168 152, 190 152, 198 162 C 184 174, 166 176, 150 170 Z" fill="#5E9C47" />
        <path class="bud" style="--gd:1.6s" d="M148 130 C 130 112, 108 114, 100 124 C 114 136, 132 138, 148 130 Z" fill="#8DB38B" />
        <g class="bud" style="--gd:1.9s"><g transform="translate(148 74)">
          {Array.from({ length: 14 }, (_, i) => <ellipse cx="0" cy="-20" rx="5" ry="12" fill="#F5B800" transform={`rotate(${i * 25.7})`} />)}
          <circle r="13" fill="#5B3A1E" />
        </g></g>
      </svg>
      <div class="ph-text">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {intro && <p class="lead" style="max-width:720px">{intro}</p>}
      </div>
    </div>
  </div>
</header>
<style>
  .page-head { padding: 16px 0 24px; }
  .ph { display: flex; flex-direction: column; align-items: stretch; gap: 40px; padding: 28px 48px 48px; min-height: 300px; }
  .ph-text { display: flex; flex-direction: column; gap: 14px; position: relative; z-index: 1; max-width: 820px; }
  .ph-plant { position: absolute; right: 24px; bottom: 0; width: 180px; height: 200px; }
  @media (max-width: 640px) { .ph { padding: 18px 20px 28px; gap: 24px; } .ph-plant { width: 110px; height: 120px; right: 4px; opacity: .55; } }
</style>
