---
// The site's name and links, built into the top of the hero / page block (no separate header bar).
interface Props { current?: string; light?: boolean }
const { current = '', light = false } = Astro.props;
const links = [
  { href: '/financial-planning', label: 'Financial planning' },
  { href: '/wills-and-estates', label: 'Wills & estates' },
  { href: '/check', label: 'Your sunflower' },
  { href: '/articles', label: 'Articles' },
  { href: '/contact', label: 'Contact' },
];
---
<div class={`toprow ${light ? 'is-light' : ''}`}>
  <a class="tr-brand" href="/">
    <img class="tr-mark" src="/photos/lioness-face.webp" alt="" width="46" height="46" />
    Magda Jordaan
  </a>
  <nav class="tr-links" aria-label="Main">
    {links.map((l) => <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>)}
  </nav>
</div>
<style>
  .toprow { display: flex; align-items: center; gap: 12px 28px; flex-wrap: wrap; position: relative; z-index: 3; }
  .tr-brand { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 22px; color: var(--ink); text-decoration: none; margin-right: auto; }
  .tr-mark { width: 46px; height: 46px; border-radius: 50%; object-fit: cover; flex: none; box-shadow: 0 0 0 2px #D3A54E; background: #12302A; }
  .toprow.is-light .tr-brand { color: #F7F1E3; }
  .toprow.is-light .tr-links a { color: #E6DFCD; }
  .toprow.is-light .tr-links a::after { background: #D3A54E; }
  .tr-links { display: flex; gap: 22px; flex-wrap: wrap; }
  .tr-links a { color: var(--ink-2); text-decoration: none; font-weight: 600; font-size: 15px; position: relative; }
  .tr-links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px; background: var(--leaf); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease); }
  .tr-links a:hover::after, .tr-links a[aria-current='page']::after { transform: scaleX(1); }
  @media (max-width: 760px) {
    .tr-links { width: 100%; overflow-x: auto; flex-wrap: nowrap; gap: 16px; white-space: nowrap; scrollbar-width: none; padding-bottom: 2px; }
    .tr-links::-webkit-scrollbar { display: none; }
    .tr-links a { font-size: 14px; }
  }
</style>
