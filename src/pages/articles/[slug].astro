---
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { compliance } from '../../config/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft);
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const date = article.data.date.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={article.data.title} description={article.data.description} legal={article.data.legal}>
  <PageHead eyebrow={date} title={article.data.title} intro={article.data.description} />
  <section>
    <div class="wrap prose">
    <Content />
    <hr />
    <p class="muted small">{compliance.postDisclaimer}</p>
    <p><a class="btn btn-primary" href="/check">Plant your family’s sunflower</a></p>
  </div>
  </section>
</Base>
