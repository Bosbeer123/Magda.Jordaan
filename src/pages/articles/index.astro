---
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Drafts show while developing (npm run dev) and are hidden in the live build.
const articles = (await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Articles" description="Plain-language articles on wills, estates and financial planning in South Africa.">
  <PageHead title="Plain language, three times a week" intro="What I tell clients across the table, written down. Also on LinkedIn and Facebook." />
  <section>
    <div class="wrap prose">
    {articles.length === 0 && <p class="muted">The first articles are on their way.</p>}
    <ul class="list">
      {articles.map((a) => (
        <li>
          <a href={`/articles/${a.id}`}>{a.data.title}</a>
          {a.data.draft && <span class="todo">draft</span>}
          <br /><span class="muted small">{a.data.description}</span>
        </li>
      ))}
    </ul>
  </div>
  </section>
</Base>

<style>
  .list { list-style: none; padding: 0; }
  .list li { padding: 14px 0; border-bottom: 1px solid var(--line); }
</style>
