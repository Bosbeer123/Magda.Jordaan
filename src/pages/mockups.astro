---
// Design choices for Magda and Tyrone: five sunflower hero designs, three parrot colours, three perches.
// Not linked from the site and never indexed. Delete this page once the choices are made.
import Base from '../layouts/Base.astro';
import ParrotArt from '../components/ParrotArt';

let seed = 5;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const R = (n: number) => Math.round(n * 10) / 10;
const pick = <T,>(a: T[]) => a[Math.floor(rnd() * a.length)];
const GREENS = ['#3F7A33', '#4E8B3A', '#5E9C47', '#6DA850', '#7FAE66'];
type Head = { x: number; y: number; s: number; rot: number; sx: number; kind: string; o?: number };
type Stem = { d: string; w: number; c: string };
type Leaf = { x: number; y: number; rot: number; k: number; c: string };
const stem = (x: number, y: number, ground = 600, lean = 0, w = 4, c = '#4E8B3A'): Stem =>
  ({ d: `M${R(x + lean)} ${ground} C ${R(x + lean * .8)} ${R(y + (ground - y) * .6)}, ${R(x + lean * .1)} ${R(y + (ground - y) * .25)}, ${R(x)} ${R(y)}`, w, c });
const kindOf = () => (rnd() < .5 ? 'sfA' : 'sfB');

// ── A · Meadow: a field along the bottom that rises to the right and thins out towards the text
const A = { heads: [] as Head[], stems: [] as Stem[], leaves: [] as Leaf[] };
[[0, 418, 24, 30, 430], [1, 456, 40, 46, 500], [2, 506, 66, 74, 600], [3, 560, 96, 104, 700]].forEach(([row, base, size, step, x0]) => {
  for (let x = x0 + rnd() * step; x < 1240; x += step * (0.8 + rnd() * 0.45)) {
    const y = base - (x - 400) * 0.07 + (rnd() - .5) * size * .5, s = size * (0.8 + rnd() * 0.4);
    const fade = Math.min(1, (x - x0 + 60) / 260);
    if (row >= 1 && fade > .6) A.stems.push(stem(x, y, 620, (rnd() - .5) * 20, Math.max(2, s / 16), row === 3 ? '#4E8B3A' : '#6E9C59'));
    if (row >= 2) for (let j = 0; j < 2; j++) A.leaves.push({ x: R(x + (rnd() - .5) * 8), y: R(y + s * (0.9 + j * 0.9)), rot: Math.round(j ? -150 + rnd() * 30 : -30 - rnd() * 30), k: R(s / 60), c: pick(GREENS) });
    A.heads.push({ x: R(x), y: R(y), s: Math.round(s), rot: Math.round((rnd() - .5) * 30), sx: R(0.78 + rnd() * 0.22), kind: kindOf(), o: R(fade * (row === 0 ? .8 : 1)) });
  }
});

// ── B · Hillside: one soft hill on the right, sunflowers planted in curving rows that follow it
const hillY = (x: number) => 360 + Math.pow((x - 960) / 330, 2) * 150;
const B = { heads: [] as Head[], stems: [] as Stem[], leaves: [] as Leaf[] };
for (let r = 0; r < 7; r++) {
  const size = 18 + r * r * 2.6 + r * 6, step = size * 1.05;
  for (let x = 560 + rnd() * step; x < 1260; x += step * (0.85 + rnd() * 0.3)) {
    const y = hillY(x) + 14 + r * r * 5.5 + r * 10 + (rnd() - .5) * size * .3;
    if (y > 640) continue;
    if (r >= 3) B.stems.push(stem(x, y, y + size * 1.6, (rnd() - .5) * 8, Math.max(2, size / 16)));
    if (r >= 4) B.leaves.push({ x: R(x), y: R(y + size * .9), rot: Math.round(rnd() < .5 ? -30 : -150), k: R(size / 55), c: pick(GREENS) });
    B.heads.push({ x: R(x), y: R(y), s: Math.round(size * (0.85 + rnd() * 0.3)), rot: Math.round((rnd() - .5) * 24), sx: R(0.8 + rnd() * 0.2), kind: kindOf() });
  }
}

// ── C · Garden border: nine tall, upright sunflowers standing around the portrait (no arch, no lean)
const Cback = [[690, 175, 118], [930, 92, 96], [1095, 150, 128], [620, 380, 74], [1190, 300, 92]];
const Cfront = [[760, 352, 104], [1100, 352, 112], [830, 470, 84], [1010, 455, 90], [1175, 490, 78], [690, 500, 70]];
const Cmake = (list: number[][]) => list.map(([x, y, s]) => ({ h: { x, y, s, rot: Math.round((rnd() - .5) * 16), sx: R(0.86 + rnd() * 0.14), kind: kindOf() } as Head, st: stem(x, y + s * .3, 620, (rnd() - .5) * 14, Math.max(3, s / 15)),
  lv: [0, 1].map((j) => ({ x: x + (j ? 4 : -4), y: R(y + s * .3 + (620 - y) * (0.35 + j * 0.3)), rot: j ? -155 : -25, k: R(s / 62), c: pick(GREENS) })) }));
const C = { back: Cmake(Cback), front: Cmake(Cfront) };

// ── D · Wreath: a round crown of sunflowers and leaves around the portrait, a low strip of field below
const D = { heads: [] as Head[], leaves: [] as Leaf[], field: [] as Head[] };
const DC = { x: 890, y: 285, r: 182 };
for (let i = 0; i < 26; i++) {
  const a = (i / 26) * Math.PI * 2 - Math.PI / 2 + (rnd() - .5) * .06, rr = DC.r + (rnd() - .5) * 16;
  D.leaves.push({ x: R(DC.x + Math.cos(a + .1) * (rr + 6)), y: R(DC.y + Math.sin(a + .1) * (rr + 6)), rot: Math.round(a * 180 / Math.PI + (i % 2 ? 60 : -60)), k: R(0.9 + rnd() * .4), c: pick(GREENS) });
  D.heads.push({ x: R(DC.x + Math.cos(a) * rr), y: R(DC.y + Math.sin(a) * rr), s: Math.round(i % 2 ? 48 + rnd() * 10 : 66 + rnd() * 14), rot: Math.round(rnd() * 40), sx: R(0.86 + rnd() * 0.14), kind: kindOf() });
}
for (let x = 560 + rnd() * 30; x < 1240; x += 34 + rnd() * 14) D.field.push({ x: R(x), y: R(560 + rnd() * 26), s: Math.round(26 + rnd() * 14), rot: 0, sx: 1, kind: kindOf() });

// ── E · Golden hour: a big pale sun behind her, flat rows of little sunflowers running to the horizon
const E = { rows: [] as { y: number; band: string; heads: Head[] }[] };
for (let j = 0; j < 9; j++) {
  const y = 430 + Math.pow(j, 1.55) * 9.5, s = 7 + j * 6.5, step = s * 1.25;
  const heads: Head[] = [];
  for (let x = 420 + (j % 2) * step / 2 - (j * 14); x < 1240; x += step) heads.push({ x: R(x + (rnd() - .5) * 3), y: R(y), s: Math.round(s), rot: 0, sx: 1, kind: 'sfFlat', o: R(Math.min(1, (x - 380 + j * 20) / 240)) });
  E.rows.push({ y, band: GREENS[Math.min(4, 4 - Math.floor(j / 2))], heads });
}

const designs = [
  { id: 'A', name: 'Meadow', note: 'A field along the bottom that rises to the right and thins out towards the text. Calm, wide, she stands above it in the sun.', portrait: { x: 900, y: 235, r: 122 } },
  { id: 'B', name: 'Hillside', note: 'One soft hill on the right with sunflowers planted in curving rows down its side. She sits on the crest like the sun coming up.', portrait: { x: 960, y: 205, r: 116 } },
  { id: 'C', name: 'Garden border', note: 'Nine tall sunflowers standing straight up around her, some behind, some in front. Like standing in her own garden. Nothing skew.', portrait: { x: 930, y: 285, r: 128 } },
  { id: 'D', name: 'Wreath', note: 'A neat round crown of sunflowers and leaves around the photo, with a low strip of field underneath. Tidy and symmetrical.', portrait: { x: DC.x, y: DC.y, r: 140 } },
  { id: 'E', name: 'Golden hour', note: 'Modern and graphic: a big pale sun behind her and flat rows of little sunflowers running to the horizon.', portrait: { x: 890, y: 270, r: 122 } },
];
const palettes = [
  { id: 'green', name: 'Green (now)', note: 'The Cape parrot, South Africa’s own. Blends in with the leaves.' },
  { id: 'red', name: 'Red', note: 'Momentum red with green wings. Stands out on the cream and the greens.' },
  { id: 'scarlet', name: 'Scarlet', note: 'Red, yellow and blue like a macaw. The most colourful, the least “Momentum”.' },
] as const;
---
<Base title="Design choices" description="Mockups to choose from.">
  <section class="mk wrap">
    <p class="eyebrow">Mockups · not part of the website</p>
    <h1 class="h1">Pick a sunflower</h1>
    <p class="lead">Five ways to bring the sunflowers into the first screen. Same photo, same words; only the garden changes. Then the parrot’s colour and a perch for it on the boxes.</p>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <linearGradient id="mkP" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#EFA20A" /><stop offset="1" stop-color="#FFD24A" /></linearGradient>
        <radialGradient id="mkSun"><stop offset="0" stop-color="#FFE7A3" stop-opacity=".95" /><stop offset=".55" stop-color="#FCEFC8" stop-opacity=".7" /><stop offset="1" stop-color="#FCEFC8" stop-opacity="0" /></radialGradient>
        <radialGradient id="mkDisc" cx="45%" cy="40%"><stop offset="0" stop-color="#FDE6A2" /><stop offset="1" stop-color="#F6CF6E" /></radialGradient>
        <linearGradient id="mkField" x1="0" y1="0" x2="1" y2="0"><stop offset=".2" stop-color="#C8DBBB" stop-opacity=".25" /><stop offset=".5" stop-color="#8FB57F" /><stop offset="1" stop-color="#6E9C59" /></linearGradient>
        <filter id="mkShadow" x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#14322B" flood-opacity=".18" /></filter>
        <symbol id="sfA" viewBox="-50 -50 100 100" overflow="visible">
          {Array.from({ length: 16 }, (_, i) => <path d="M0 -16 C 9 -22, 10 -38, 0 -47 C -10 -38, -9 -22, 0 -16 Z" fill="url(#mkP)" transform={`rotate(${i * 22.5})`} />)}
          {Array.from({ length: 16 }, (_, i) => <path d="M0 -16 C 6 -21, 7 -31, 0 -38 C -7 -31, -6 -21, 0 -16 Z" fill="#F4B000" opacity=".55" transform={`rotate(${i * 22.5 + 11.25})`} />)}
          <circle r="18" fill="#5A3A1C" /><circle r="12" fill="#3E2611" /><circle r="18" fill="none" stroke="#8C6526" stroke-width="2.5" stroke-dasharray="1.5 2.5" />
        </symbol>
        <symbol id="sfB" viewBox="-50 -50 100 100" overflow="visible">
          {Array.from({ length: 20 }, (_, i) => <path d={`M0 -15 C 7 -21, 8 ${-36 - (i % 3) * 3}, 0 ${-46 - (i % 3) * 2} C -8 ${-36 - (i % 3) * 3}, -7 -21, 0 -15 Z`} fill={i % 2 ? '#F2A70E' : 'url(#mkP)'} transform={`rotate(${i * 18 + (i % 4) * 2})`} />)}
          <circle r="17" fill="#4C2F15" /><circle r="11" fill="#33200D" /><circle r="16" fill="none" stroke="#9A7029" stroke-width="2" stroke-dasharray="1.2 2.2" />
        </symbol>
        <symbol id="sfFlat" viewBox="-50 -50 100 100" overflow="visible">
          {Array.from({ length: 12 }, (_, i) => <ellipse cx="0" cy="-32" rx="9" ry="16" fill="#F3B21A" transform={`rotate(${i * 30})`} />)}
          <circle r="20" fill="#5A3A1C" />
        </symbol>
        <symbol id="lf" viewBox="0 -20 60 40" overflow="visible">
          <path d="M0 0 C 8 -14, 30 -22, 50 -14 C 58 -10, 60 -4, 58 0 C 56 4, 50 12, 36 14 C 20 16, 6 8, 0 0 Z" fill="currentColor" />
          <path d="M2 0 C 20 -2, 40 -2, 56 -1" fill="none" stroke="#2F5F2A" stroke-width="1.3" opacity=".45" />
        </symbol>
        <clipPath id="mkClip" clipPathUnits="objectBoundingBox"><circle cx=".5" cy=".5" r=".5" /></clipPath>
      </defs>
    </svg>

    {designs.map((d) => (
      <article class="mk-card">
        <div class="mk-head"><span class="mk-badge">{d.id}</span><div><h2 class="h3">{d.name}</h2><p class="muted">{d.note}</p></div></div>
        <div class="mk-stage">
          <svg viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid slice" class="mk-art" aria-hidden="true">
            <rect width="1200" height="620" fill="#F5F1E8" />
            {d.id === 'A' && <>
              <circle cx="900" cy="230" r="260" fill="url(#mkSun)" />
              <path d="M0 560 C 260 540, 420 500, 620 450 C 820 404, 1000 380, 1200 360 V 620 H 0 Z" fill="#DCE7D2" />
              {A.stems.map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} fill="none" stroke-linecap="round" />)}
              {A.leaves.map((l) => <use href="#lf" x="0" y="-20" width="60" height="40" transform={`translate(${l.x} ${l.y}) rotate(${l.rot}) scale(${l.k})`} style={`color:${l.c}`} />)}
              {A.heads.map((h) => <g opacity={h.o} transform={`translate(${h.x} ${h.y}) rotate(${h.rot}) scale(${h.sx} 1)`}><use href={`#${h.kind}`} x={-h.s / 2} y={-h.s / 2} width={h.s} height={h.s} /></g>)}
            </>}
            {d.id === 'B' && <>
              <circle cx="960" cy="200" r="250" fill="url(#mkSun)" />
              <path d={`M480 620 C 600 520, 760 ${hillY(800)}, 960 360 C 1100 362, 1180 400, 1240 430 V 620 Z`} fill="#A9C59E" />
              <path d={`M560 620 C 660 540, 800 420, 960 372 C 1080 376, 1170 410, 1240 440 V 620 Z`} fill="#8FB57F" />
              {B.stems.map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} fill="none" stroke-linecap="round" />)}
              {B.leaves.map((l) => <use href="#lf" x="0" y="-20" width="60" height="40" transform={`translate(${l.x} ${l.y}) rotate(${l.rot}) scale(${l.k})`} style={`color:${l.c}`} />)}
              {B.heads.map((h) => <g transform={`translate(${h.x} ${h.y}) rotate(${h.rot}) scale(${h.sx} 1)`}><use href={`#${h.kind}`} x={-h.s / 2} y={-h.s / 2} width={h.s} height={h.s} /></g>)}
            </>}
            {d.id === 'C' && <>
              <circle cx="930" cy="280" r="270" fill="url(#mkSun)" />
              {C.back.map((f) => <g opacity=".92"><path d={f.st.d} stroke="#6E9C59" stroke-width={f.st.w} fill="none" stroke-linecap="round" />{f.lv.map((l) => <use href="#lf" x="0" y="-20" width="60" height="40" transform={`translate(${l.x} ${l.y}) rotate(${l.rot}) scale(${l.k})`} style={`color:${l.c}`} />)}<g transform={`translate(${f.h.x} ${f.h.y}) rotate(${f.h.rot}) scale(${f.h.sx} 1)`}><use href={`#${f.h.kind}`} x={-f.h.s / 2} y={-f.h.s / 2} width={f.h.s} height={f.h.s} /></g></g>)}
            </>}
            {d.id === 'D' && <>
              <circle cx={DC.x} cy={DC.y} r="290" fill="url(#mkSun)" />
              <path d="M420 580 C 700 560, 900 560, 1240 548 V 620 H 420 Z" fill="#B9CFA9" />
              {D.field.map((h) => <g transform={`translate(${h.x} ${h.y})`}><path d={`M0 0 V 70`} stroke="#6E9C59" stroke-width="3" /><use href={`#${h.kind}`} x={-h.s / 2} y={-h.s / 2} width={h.s} height={h.s} /></g>)}
              {D.leaves.map((l) => <use href="#lf" x="0" y="-20" width="60" height="40" transform={`translate(${l.x} ${l.y}) rotate(${l.rot}) scale(${l.k})`} style={`color:${l.c}`} />)}
            </>}
            {d.id === 'E' && <>
              <circle cx="890" cy="300" r="250" fill="url(#mkDisc)" />
              <path d="M0 430 H 1200 V 620 H 0 Z" fill="url(#mkField)" />
              {E.rows.map((r) => <g>{r.heads.map((h) => <use href="#sfFlat" x={h.x - h.s / 2} y={h.y - h.s / 2} width={h.s} height={h.s} opacity={h.o} />)}</g>)}
              <rect x="0" y="426" width="1200" height="6" fill="#F5F1E8" opacity=".6" />
            </>}

            <g filter="url(#mkShadow)">
              <circle cx={d.portrait.x} cy={d.portrait.y} r={d.portrait.r + 10} fill="#fff" />
            </g>
            <image href="/magda.webp" x={d.portrait.x - d.portrait.r} y={d.portrait.y - d.portrait.r} width={d.portrait.r * 2} height={d.portrait.r * 2} clip-path="url(#mkClip)" preserveAspectRatio="xMidYMid slice" />

            {d.id === 'C' && C.front.map((f) => <g><path d={f.st.d} stroke="#4E8B3A" stroke-width={f.st.w} fill="none" stroke-linecap="round" />{f.lv.map((l) => <use href="#lf" x="0" y="-20" width="60" height="40" transform={`translate(${l.x} ${l.y}) rotate(${l.rot}) scale(${l.k})`} style={`color:${l.c}`} />)}<g transform={`translate(${f.h.x} ${f.h.y}) rotate(${f.h.rot}) scale(${f.h.sx} 1)`}><use href={`#${f.h.kind}`} x={-f.h.s / 2} y={-f.h.s / 2} width={f.h.s} height={f.h.s} /></g></g>)}
            {d.id === 'D' && D.heads.map((h) => <g transform={`translate(${h.x} ${h.y}) rotate(${h.rot}) scale(${h.sx} 1)`}><use href={`#${h.kind}`} x={-h.s / 2} y={-h.s / 2} width={h.s} height={h.s} /></g>)}

            <path d="M0 586 C 300 568, 700 596, 1200 578 V 620 H 0 Z" fill="#A9C59E" />
            <path d="M0 604 C 400 594, 800 610, 1200 600 V 620 H 0 Z" fill="#5A4433" />
          </svg>
          <div class="mk-text">
            <p class="eyebrow">Financial adviser · Admitted attorney</p>
            <p class="mk-h">I’ve wound up the estates that bad planning leaves behind.</p>
            <p class="mk-l">Financial planning through <span class="momentum">Momentum Consult</span>, wills and estates as an attorney.</p>
            <div class="mk-pills"><span></span><span></span><span></span><span></span></div>
          </div>
        </div>
      </article>
    ))}

    <h2 class="h2 mk-sec">The parrot’s colour</h2>
    <p class="lead">Each one sitting and flying. The flying wings are new: two open wings that flap from the shoulder, instead of the folded wing swinging.</p>
    <div class="mk-parrots">
      {palettes.map((p) => (
        <div class="mk-p block">
          <div class="mk-p-art">
            <ParrotArt palette={p.id} width={120} />
            <ParrotArt palette={p.id} width={120} flying />
          </div>
          <h3 class="h3">{p.name}</h3>
          <p class="muted">{p.note}</p>
        </div>
      ))}
    </div>

    <h2 class="h2 mk-sec">A perch on the boxes</h2>
    <p class="lead">A little branch on a few chosen boxes, where the parrot lands to say something.</p>
    <div class="mk-perches">
      <div class="mk-box block">
        <svg class="perch" viewBox="0 0 220 60" aria-hidden="true">
          <path d="M150 40 C 160 28, 172 22, 186 20" stroke="#7A5C47" stroke-width="3.5" stroke-linecap="round" fill="none" />
          <use href="#lf" x="0" y="-20" width="60" height="40" transform="translate(186 20) rotate(-30) scale(.55)" style="color:#5E9C47" />
          <path d="M70 52 C 120 47, 170 41, 214 32" stroke="#7A5C47" stroke-width="6" stroke-linecap="round" fill="none" />
          <use href="#lf" x="0" y="-20" width="60" height="40" transform="translate(84 50) rotate(150) scale(.45)" style="color:#6DA850" />
          <g transform="translate(110 4)"><ParrotArt palette="red" width={40} /></g>
        </svg>
        <h3 class="h3">1 · Twig on the corner</h3>
        <p class="muted">A thin branch with a few leaves resting on the top corner.</p>
      </div>
      <div class="mk-box block">
        <svg class="perch" viewBox="0 0 220 60" aria-hidden="true">
          <path d="M60 52 C 110 49, 160 46, 206 42" stroke="#7A5C47" stroke-width="6" stroke-linecap="round" fill="none" />
          <path d="M186 44 C 190 34, 192 24, 192 14" stroke="#4E8B3A" stroke-width="3" stroke-linecap="round" fill="none" />
          <use href="#lf" x="0" y="-20" width="60" height="40" transform="translate(190 32) rotate(-25) scale(.4)" style="color:#5E9C47" />
          <use href="#sfA" x="174" y="-6" width="36" height="36" />
          <g transform="translate(104 6)"><ParrotArt palette="red" width={40} /></g>
        </svg>
        <h3 class="h3">2 · Branch with a sunflower</h3>
        <p class="muted">The same branch, with a small sunflower growing off the end.</p>
      </div>
      <div class="mk-box block">
        <svg class="perch" viewBox="0 0 220 60" aria-hidden="true">
          <path d="M6 48 C 70 42, 150 42, 214 48" stroke="#7A5C47" stroke-width="5" stroke-linecap="round" fill="none" />
          {[24, 58, 150, 186, 206].map((x, i) => <g><path d={`M${x} 45 C ${x + 3} ${54 + i * 2}, ${x - 2} ${60 + i * 2}, ${x + 1} ${66 + (i % 3) * 6}`} stroke="#5E9C47" stroke-width="1.6" fill="none" /><use href="#lf" x="0" y="-20" width="60" height="40" transform={`translate(${x + 1} ${64 + (i % 3) * 6}) rotate(${80 + i * 9}) scale(.3)`} style={`color:${GREENS[i % 5]}`} /></g>)}
          <g transform="translate(92 2)"><ParrotArt palette="red" width={40} /></g>
        </svg>
        <h3 class="h3">3 · Hanging vine</h3>
        <p class="muted">A branch along the top edge with little vines and leaves hanging off it.</p>
      </div>
    </div>
    <p class="muted mk-end">Tell Tyrone: a letter for the sunflowers (A–E), a colour for the parrot, and a number for the perch.</p>
  </section>
</Base>

<style>
  .mk { padding: 40px 0 60px; }
  .mk .lead { max-width: 62ch; }
  .mk-card { margin: 44px 0; }
  .mk-head { display: flex; gap: 16px; align-items: flex-start; margin-bottom: 14px; }
  .mk-head .h3 { margin: 0 0 2px; }
  .mk-head p { margin: 0; max-width: 70ch; }
  .mk-badge { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--ink); color: #fff; font: 600 20px var(--font-display); }
  .mk-stage { position: relative; border-radius: 28px; overflow: hidden; box-shadow: 0 20px 50px rgba(20,50,43,.12); aspect-ratio: 1200 / 620; background: var(--paper); }
  .mk-art { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .mk-text { position: absolute; left: 4.5%; top: 20%; width: 34%; color: var(--ink); }
  .mk-text .eyebrow { font-size: clamp(9px, 1vw, 12px); margin: 0 0 8px; }
