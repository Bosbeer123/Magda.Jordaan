---
import Base from '../layouts/Base.astro';
import TopRow from '../components/TopRow.astro';
import SunflowerTest from '../components/SunflowerTest';
import { site, compliance } from '../config/site';
const waNumber = site.whatsapp.startsWith('[') ? '' : site.whatsapp;
---
<Base
  title="Plant your family's sunflower"
  description="Ten plain questions grow your family's sunflower. Then see what happens if you pass away, can't work, or get a critical illness, and what keeps it standing."
>
  <section class="scene sf-scene snap" id="check" data-facts="sunflower">
    <div class="wrap sf-wrap" data-parrot-stop="score" data-parrot-offset="0">
      <TopRow current="/check" />
      <SunflowerTest client:load whatsapp={waNumber} title="Plant your family’s sunflower. Then bring on the weather." />
    </div>
  </section>
  <div class="wrap"><p class="muted small" style="padding:12px 0">{compliance.generalInfo} Your answers stay in your browser unless you ask for the email.</p></div>
</Base>
