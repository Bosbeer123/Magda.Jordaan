---
import Perch from '../components/Perch.astro';
import Base from '../layouts/Base.astro';
import TopRow from '../components/TopRow.astro';
import SunflowerTest from '../components/SunflowerTest';
import { getCollection } from 'astro:content';
import { site, linkedin } from '../config/site';
import Fact from '../components/Fact.astro';
import LionArt from '../components/LionArt';
import '../styles/lion.css';
// Garden design. Scenes fit the screen: 1 hero (intro + parrot + sunflower) · 2 the roots (pinned, grows as you scroll)
// · 3 the sunflower activity · then the calm blocks. Red = Momentum. Voice: short, "I", plain, never "independent".

const waNumber = site.whatsapp.startsWith('[') ? '' : site.whatsapp;

// Hero scene ("Pride"): deep green and gold, Magda's photo in a gold ring, the lioness lying at her side and a row of
// gold-line sunflowers along the bottom. Fixed seed: same every time.
let seed = 5;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const R = (n: number) => Math.round(n * 10) / 10;
const canopy: [number, number, number][] = [[196, 168, 96], [124, 196, 66], [262, 214, 66], [170, 96, 68], [248, 120, 58], [108, 134, 50]];
const canopyLeaves = canopy.flatMap(([cx, cy, r]) => Array.from({ length: 6 }, (_, i) => {
  const a = (i / 6) * Math.PI * 2 + rnd() * 0.8;
  return { x: R(cx + Math.cos(a) * r * 0.92), y: R(cy + Math.sin(a) * r * 0.92), rot: Math.round(a * 180 / Math.PI + (rnd() - .5) * 40), k: R(0.32 + rnd() * 0.22), c: ['#3F8560', '#4A9468', '#2F7352', '#57A273'][Math.floor(rnd() * 4)] };
})).filter((l) => l.y < 300);
const goldField = Array.from({ length: 22 }, (_, i) => {
  const x = R((i + 0.5) * (1440 / 22) + (rnd() - .5) * 18), s = R(34 + rnd() * 18), y = R(52 + (rnd() - .5) * 18);
  return { x, y, s, lean: R((rnd() - .5) * 10), rot: Math.round(rnd() * 30) };
});

// Underground life for the roots scene: a mossy, grassy top edge, moss clumps with little sprouts down the sides and
// between the roots, pebbles, and a couple of tiny mushrooms. Kept away from the text column. Same seed every time.
const MOSS = ['#5F7D3E', '#6F8F47', '#4D6934', '#7E9A4E', '#58763A'];
const mossClump = (cx: number, cy: number, size: number) => Array.from({ length: 7 + Math.floor(rnd() * 5) }, () => ({
  x: R(cx + (rnd() - .5) * size * 1.6), y: R(cy + (rnd() - .5) * size * .7), r: R(size * (0.22 + rnd() * 0.28)), c: MOSS[Math.floor(rnd() * MOSS.length)],
}));
const clumpSpots: [number, number, number][] = [
  [30, 140, 46], [60, 330, 34], [20, 520, 52], [70, 720, 38], [26, 860, 44],
  [1410, 120, 40], [1380, 300, 48], [1420, 480, 36], [1390, 660, 50], [1415, 840, 40],
  [820, 230, 30], [1210, 190, 34], [770, 470, 26], [1250, 520, 30], [900, 760, 34], [1160, 820, 28], [1030, 380, 20],
  [640, 880, 40], [300, 890, 34],
];
const clumps = clumpSpots.map(([x, y, s]) => ({ blobs: mossClump(x, y, s), x, y, s, depth: y / 900,
  sprout: rnd() < .6 ? { h: R(s * (0.5 + rnd() * 0.5)), lean: R((rnd() - .5) * 14) } : null }));
const grass = Array.from({ length: 150 }, (_, i) => { const x = R(i * 9.7 + rnd() * 6), h = R(10 + rnd() * 24); return { x, h, lean: R((rnd() - .5) * 10), c: MOSS[Math.floor(rnd() * MOSS.length)] }; });
const pebbles = Array.from({ length: 26 }, () => { const side = rnd() < .5; return { x: R(side ? rnd() * 120 : 760 + rnd() * 680), y: R(80 + rnd() * 810), rx: R(3 + rnd() * 7), ry: R(2 + rnd() * 4), c: rnd() < .5 ? '#6B5A4A' : '#57483B' }; });
const mushrooms = [[96, 812, 1], [1330, 760, .8], [1060, 868, .7]];


const whatsapp = waNumber ? `https://wa.me/${waNumber}` : '/contact';

const published = (await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3)
  .map((a) => ({ topic: a.data.topic, title: a.data.title, blurb: a.data.description, href: `/articles/${a.id}` }));
const planned = [
  { topic: 'estates', title: 'The will in the drawer nobody knew about', blurb: 'Why where you keep your will matters almost as much as what is in it.', href: null },
  { topic: 'estates', title: 'Why an estate takes a year, and how to make it months', blurb: 'The Master, the executor, SARS and the account that lies open for inspection.', href: null },
  { topic: 'planning', title: 'Your beneficiary nomination beats your will. Check it.', blurb: 'The one-line form from fifteen years ago that still decides who gets your policy.', href: null },
];
const articles = [...published, ...planned.filter((p) => !published.some((a) => a.title === p.title))].slice(0, 3);
const topicLabel: Record<string, string> = { estates: 'Estates', wills: 'Wills', planning: 'Planning', 'ask-magda': 'Ask Magda' };

// The roots: what has to be in place underneath. Budget 2026 figures are proposals until legislated.
const layers = [
  { id: 'health', depth: 'Topsoil', name: 'Health', line: 'Protect today', by: 'momentum', cards: [
    { t: 'Emergency money', d: 'Three to six months of living costs your person can reach. Accounts in your name freeze when you die.' },
    { t: 'Medical aid and gap cover', d: 'Medical aid pays the hospital. Gap cover pays the difference when specialists charge more.' },
    { t: 'Income protection', d: 'A monthly income if illness or injury stops you working. The bond doesn’t stop when you do.' },
    { t: 'Critical illness cover', d: 'A lump sum on diagnosis of cancer, a heart attack or a stroke. For costs nobody budgets for.' },
  ] },
  { id: 'prosperity', depth: 'Deep roots', name: 'Prosperity', line: 'Grow what you have', by: 'momentum', cards: [
    { t: 'Retirement annuity (RA)', d: 'Contributions are tax-deductible up to 27.5% of taxable income, within an annual cap (R430 000 proposed in Budget 2026).' },
    { t: 'Tax-free savings', d: 'R46 000 a year (proposed in Budget 2026, up from R36 000), R500 000 in a lifetime. Growth is never taxed.' },
    { t: 'Investments', d: 'Money you can reach before retirement, for the goals in between: a car, a deposit, a gap year.' },
    { t: 'Life cover', d: 'Clears the bond and the debts, and replaces your income for the people who depend on it.' },
  ] },
  { id: 'longevity', depth: 'The taproot', name: 'Longevity', line: 'Hand it on, properly', by: 'attorney', cards: [
    { t: 'A will', d: 'Everything else hangs from it. Without one, the Intestate Succession Act decides who inherits.' },
    { t: 'A trust for your children', d: 'Holds their inheritance until an age you choose, instead of the Guardian’s Fund paying it out at 18.' },
    { t: 'Executor and beneficiaries', d: 'An executor who has said yes. Policy nominations that name the right people: they pay out whatever your will says.' },
    { t: 'Estate duty and cash', d: 'Estate duty is 20% above R3.5 million (25% above R30 million). Your estate needs cash to pay it, and the executor.' },
  ] },
];
---
<Base
  title="Home"
  description="Magda Jordaan, Financial Adviser with Momentum Consult and admitted attorney in Centurion. Health, prosperity and longevity for your family, planned in plain language."
>
  <!-- ① Hero scene ("Pride"): her words, her photo, the lioness and the parrot. One screen, still. -->
  <section class="scene hero-scene snap" data-facts="home">
    <div class="wrap hero-wrap">
      <TopRow current="/" light />
      <div class="hero-grid">
        <div class="hero-text">
          <p class="eyebrow hero-eb">Investments · Estate planning · Centurion</p>
          <h1 class="hero-title">I want to prevent bad estate planning.</h1>
          <p class="lead">
            I&rsquo;ve wound up the estates poor planning leaves behind. Now I help families get their investments and
            estates right, through <span class="momentum-pill">Momentum Consult</span> and as an attorney.
          </p>
          <div class="ask-wrap" style="position:relative">
          <div class="ask-menu" data-parrot-menu>
            <noscript><p><a class="btn btn-primary" href="/check">Plant your family&rsquo;s sunflower</a></p></noscript>
          </div>
          </div>
        </div>
        <div class="hero-stage">
          <div class="pride">
            <span class="pride-glow" aria-hidden="true"></span>
            <span class="pride-ring" aria-hidden="true"></span>
            <div class="portrait pride-portrait">
              <img src="/magda.webp" alt="Magda Jordaan" width="800" height="800" fetchpriority="high" />
            </div>
            <!-- a little tree on the right: the parrot's branch, and shade for the lioness -->
            <svg class="pride-tree" viewBox="0 0 300 520" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
              <defs>
                <linearGradient id="trunkG" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#6B4D36" /><stop offset=".55" stop-color="#7E5C42" /><stop offset="1" stop-color="#4E3726" /></linearGradient>
                <radialGradient id="leafG" cx="35%" cy="30%" r="75%"><stop offset="0" stop-color="#3F8560" /><stop offset="1" stop-color="#1F5440" /></radialGradient>
                <symbol id="trLeaf" viewBox="0 -20 60 40" overflow="visible"><path d="M0 0 C 8 -14, 30 -22, 50 -14 C 58 -10, 60 -4, 58 0 C 56 4, 50 12, 36 14 C 20 16, 6 8, 0 0 Z" fill="currentColor" /></symbol>
              </defs>
              <!-- canopy, behind -->
              <g class="sway" style="animation-duration:12s">
                <circle cx="196" cy="168" r="96" fill="url(#leafG)" />
                <circle cx="124" cy="196" r="66" fill="#2A6A4C" />
                <circle cx="262" cy="214" r="66" fill="#245C44" />
                <circle cx="170" cy="96" r="68" fill="#34795A" />
                <circle cx="248" cy="120" r="58" fill="#2D6E50" />
                <circle cx="108" cy="134" r="50" fill="#3A7F5D" />
                {canopyLeaves.map((l) => <use href="#trLeaf" x="0" y="-20" width="60" height="40" transform={`translate(${l.x} ${l.y}) rotate(${l.rot}) scale(${l.k})`} style={`color:${l.c}`} />)}
                <g fill="#D3A54E" opacity=".55"><circle cx="150" cy="80" r="3" /><circle cx="214" cy="104" r="2.5" /><circle cx="120" cy="170" r="2.5" /><circle cx="250" cy="180" r="3" /><circle cx="186" cy="200" r="2" /><circle cx="96" cy="128" r="2" /></g>
              </g>
              <!-- trunk and roots -->
              <path d="M184 520 C 192 462, 194 402, 190 342 C 187 300, 184 272, 172 242 L 196 236 C 204 270, 210 302, 214 344 C 218 404, 222 462, 236 520 Z" fill="url(#trunkG)" />
              <path d="M200 300 C 203 340, 205 390, 204 440" stroke="#A3836A" stroke-width="2" fill="none" opacity=".45" />
              <path d="M184 520 C 176 512, 164 510, 152 514 M236 520 C 244 510, 258 508, 270 514" stroke="#5B4232" stroke-width="7" fill="none" stroke-linecap="round" />
              <path d="M200 252 C 218 226, 238 204, 262 186" stroke="#6B4D36" stroke-width="9" fill="none" stroke-linecap="round" />
              <!-- the parrot's branch -->
              <path d="M192 304 C 160 292, 118 286, 66 284 C 59 284, 58 291, 65 291.5 C 118 294, 160 304, 194 322 Z" fill="#6B4D36" />
              <path d="M190 305 C 158 294, 118 288.5, 68 286" stroke="#A3836A" stroke-width="1.6" fill="none" opacity=".7" />
              <path d="M96 287 C 92 276, 94 266, 102 258" stroke="#6B4D36" stroke-width="3" fill="none" stroke-linecap="round" />
              <use href="#trLeaf" x="0" y="-20" width="60" height="40" transform="translate(102 258) rotate(-70) scale(.5)" style="color:#3F8560" />
              <use href="#trLeaf" x="0" y="-20" width="60" height="40" transform="translate(66 288) rotate(165) scale(.42)" style="color:#4A9468" />
              <use href="#trLeaf" x="0" y="-20" width="60" height="40" transform="translate(150 296) rotate(110) scale(.36)" style="color:#2F7352" />
              <rect data-parrot-home x="112" y="286" width="30" height="2" fill="transparent" />
            </svg>
            <button class="pride-lion" type="button" data-lion data-lion-home aria-label="The lioness: tap for something useful">
              <LionArt pose="lie" width={340} />
              <span class="perch-spot" data-parrot-perch data-face="-1" style="left:46%;top:58%"></span>
            </button>
          </div>
        </div>
      </div>
    </div>
    <svg class="gold-field" viewBox="0 0 1440 110" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <symbol id="sfGold" viewBox="-50 -50 100 100" overflow="visible">
          <g fill="none" stroke="#D3A54E" stroke-width="2.6">{Array.from({ length: 15 }, (_, i) => <ellipse cx="0" cy="-30" rx="7" ry="15" transform={`rotate(${i * 24})`} />)}<circle r="15" /></g>
          <circle r="7" fill="#D3A54E" opacity=".5" />
        </symbol>
      </defs>
      {goldField.map((f) => (
        <g>
          <path d={`M${f.x + f.lean} 112 C ${f.x + f.lean} ${f.y + 40}, ${f.x} ${f.y + 30}, ${f.x} ${f.y + f.s * .35}`} stroke="#D3A54E" stroke-opacity=".55" stroke-width="2" fill="none" />
          <use href="#sfGold" x={f.x - f.s / 2} y={f.y - f.s / 2} width={f.s} height={f.s} transform={`rotate(${f.rot} ${f.x} ${f.y})`} />
        </g>
      ))}
    </svg>
    <svg class="horizon" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 52 C 240 30, 480 58, 720 46 S 1200 30, 1440 50 V 120 H 0 Z" fill="#1E4438" />
      <path d="M0 74 C 300 62, 620 84, 960 70 S 1300 66, 1440 76 V 120 H 0 Z" fill="#5A4433" />
    </svg>
    <a class="dig" href="#roots">Scroll into the roots <span aria-hidden="true">↓</span></a>
  </section>

  <!-- ② The roots: pinned scene, the roots grow as you scroll -->
  <section class="roots" id="roots" data-facts="roots" aria-label="The roots: what has to be in place underneath">
    {layers.map((l, i) => (
      <div class="roots-anchor" style={`top:calc(300vh * ${0.2 + i * 0.28})`} data-parrot-stop={l.id} data-parrot-perch-on="#roots-perch" data-parrot-offset="0"></div>
    ))}
    <div class="roots-stage" data-active="-1">
      <svg class="soil-life" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <!-- topsoil: a mossy lip with grass growing up into the light -->
        <path d="M0 0 H 1440 V 34 C 1300 46, 1180 30, 1040 42 C 900 54, 760 36, 620 46 C 470 56, 330 38, 200 48 C 120 54, 60 44, 0 50 Z" fill="#4D6934" />
        <path d="M0 0 H 1440 V 20 C 1260 30, 1100 18, 940 28 C 780 38, 600 22, 430 32 C 280 40, 140 26, 0 34 Z" fill="#6F8F47" />
        {grass.map((g) => <path d={`M${g.x} 30 q ${g.lean} ${-g.h * .6} ${g.lean * 1.4} ${-g.h}`} stroke={g.c} stroke-width="2.2" fill="none" stroke-linecap="round" />)}
        {grass.filter((_, i) => i % 3 === 0).map((g) => <path d={`M${g.x} 40 q ${-g.lean * .5} ${g.h * .5} ${g.lean * .3} ${g.h * .9}`} stroke="#8C7A5E" stroke-width="1" fill="none" opacity=".5" />)}
        {pebbles.map((p) => <ellipse cx={p.x} cy={p.y} rx={p.rx} ry={p.ry} fill={p.c} opacity=".8" />)}
        {clumps.map((c) => (
          <g opacity={(0.95 - c.depth * 0.35).toFixed(2)}>
            {c.blobs.map((b) => <circle cx={b.x} cy={b.y} r={b.r} fill={b.c} />)}
            {c.blobs.slice(0, 4).map((b) => <circle cx={R(b.x - b.r * .3)} cy={R(b.y - b.r * .35)} r={R(b.r * .35)} fill="#9BB565" opacity=".35" />)}
            {c.sprout && <g stroke="#86A856" stroke-width="2" fill="none" stroke-linecap="round">
              <path d={`M${c.x} ${c.y - c.s * .2} q ${c.sprout.lean} ${-c.sprout.h * .6} 0 ${-c.sprout.h}`} />
              <path d={`M${c.x + c.sprout.lean * .4} ${c.y - c.s * .2 - c.sprout.h * .7} q 8 -6 14 -2 q -6 6 -14 2 Z`} fill="#86A856" />
              <path d={`M${c.x + c.sprout.lean * .3} ${c.y - c.s * .2 - c.sprout.h * .5} q -8 -6 -13 -1 q 6 5 13 1 Z`} fill="#7E9A4E" />
            </g>}
          </g>
        ))}
        {mushrooms.map(([x, y, k]) => (
          <g transform={`translate(${x} ${y}) scale(${k})`} opacity=".9">
            <path d="M-3 0 C -3 -8, -2 -14, 0 -16 C 2 -14, 3 -8, 3 0 Z" fill="#E8DCC5" />
            <path d="M-12 -14 C -10 -24, 10 -24, 12 -14 Z" fill="#B5643F" />
            <circle cx="-4" cy="-18" r="1.6" fill="#F3E6CF" /><circle cx="4" cy="-19" r="1.2" fill="#F3E6CF" />
          </g>
        ))}
      </svg>
      <div class="wrap roots-grid">
        <div class="roots-text">
          <span id="roots-perch" class="roots-perch" aria-hidden="true"></span>
          <div class="layer layer-intro">
            <p class="eyebrow light">Underground</p>
            <h2>Every sunflower stands on its roots.</h2>
            <p class="soil-lead">What people see is the flower. What holds it up in a storm is underneath. Keep scrolling: these are the roots I help families put down.</p>
          </div>
          {layers.map((l, i) => (
            <div class={`layer layer-${l.id}`} data-layer={i}>
              <p class="eyebrow light">{l.depth}</p>
              <h2>{l.name}<span>. {l.line}</span></h2>
              <span class={l.by === 'momentum' ? 'badge-momentum' : 'badge-attorney dark'}>{l.by === 'momentum' ? 'Momentum Consult' : 'M Jordaan Attorney'}</span>
              <ul class="root-cards">
                {l.cards.map((c, j) => <li style={`--i:${j}`}><b>{c.t}</b><span>{c.d}</span></li>)}
              </ul>
              {l.id === 'prosperity' && <p class="fine">Budget 2026 figures are proposals until they are law.</p>}
            </div>
          ))}
        </div>
        <svg class="roots-svg" viewBox="0 0 600 900" preserveAspectRatio="xMidYMin meet" aria-hidden="true">
          <path class="root root-tap" pathLength="1" d="M300 0 C 296 120, 308 240, 298 360 C 290 480, 306 600, 300 720 C 296 790, 302 850, 300 900" />
          <g data-l="0">
            <path class="root" pathLength="1" d="M300 60 C 250 80, 200 70, 140 110" /><circle class="node" cx="140" cy="110" r="8" />
            <path class="root" pathLength="1" d="M302 90 C 360 110, 420 100, 480 140" /><circle class="node" cx="480" cy="140" r="8" />
            <path class="root" pathLength="1" d="M298 170 C 240 190, 180 200, 110 240" /><circle class="node" cx="110" cy="240" r="8" />
            <path class="root" pathLength="1" d="M301 200 C 360 220, 430 230, 500 270" /><circle class="node" cx="500" cy="270" r="8" />
          </g>
          <g data-l="1">
            <path class="root" pathLength="1" d="M299 320 C 220 340, 140 360, 70 420" /><circle class="node gold" cx="70" cy="420" r="9" />
            <path class="root" pathLength="1" d="M300 360 C 380 380, 470 400, 540 450" /><circle class="node gold" cx="540" cy="450" r="9" />
            <path class="root" pathLength="1" d="M297 460 C 230 480, 170 500, 120 550" /><circle class="node gold" cx="120" cy="550" r="9" />
            <path class="root" pathLength="1" d="M303 500 C 370 520, 430 540, 480 590" /><circle class="node gold" cx="480" cy="590" r="9" />
          </g>
          <g data-l="2">
            <path class="root" pathLength="1" d="M300 640 C 250 670, 220 700, 190 760" /><circle class="node deep" cx="190" cy="760" r="10" />
            <path class="root" pathLength="1" d="M301 680 C 350 710, 380 740, 410 800" /><circle class="node deep" cx="410" cy="800" r="10" />
            <path class="root" pathLength="1" d="M299 780 C 270 810, 250 840, 240 880" /><circle class="node deep" cx="240" cy="880" r="10" />
            <path class="root" pathLength="1" d="M300 820 C 330 840, 350 860, 360 895" /><circle class="node deep" cx="360" cy="895" r="10" />
          </g>
        </svg>
        <ol class="depth" aria-hidden="true">
          <li data-d="0">Topsoil</li><li data-d="1">Deep roots</li><li data-d="2">Taproot</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ③ The sunflower activity: one screen -->
  <section class="scene sf-scene snap" id="check" data-facts="sunflower">
    <div class="wrap sf-wrap" data-parrot-stop="score" data-parrot-offset="0">
      <SunflowerTest client:visible whatsapp={waNumber} title="Plant your family’s sunflower. Then bring on the weather." />
    </div>
  </section>

  <!-- ④ Calm blocks -->
  <section>
    <div class="wrap bento">
      <div class="block span-7 reveal story has-nook">
        <Perch kind="sunflower" side="right" />
        <p class="quote">&ldquo;Awareness before desire.&rdquo;</p>
        <p style="color:var(--ink-2)">
          I started in underwriting, in senior roles at Liberty and Momentum. Then I qualified as an attorney and spent
          years winding up deceased estates. Over and over I saw families who loved each other, left unprepared because
          nobody told them the truth while there was still time. So that&rsquo;s the job now.
        </p>
        <ol class="steps">
          <li><b>Underwriting</b> Liberty and Momentum</li>
          <li><b>Attorney</b> deceased estates</li>
          <li><b>Adviser</b> <span class="momentum">Momentum Consult</span> Castle Gate</li>
        </ol>
      </div>
      <a class="block block-ink span-5 reveal death lift has-nook" style="--d:.1s" href="/report-a-death" data-parrot-stop="death" data-facts="death">
        <Perch kind="vine" side="right" dark />
        <p class="eyebrow" style="color:var(--moss)">If someone has just died</p>
        <h3>Breathe. Here is what to do first, in order.</h3>
        <p style="color:#C9D8CF">The estate must be reported to the Master within 14 days. The checklist shows every document. Or phone me, and I&rsquo;ll carry it.</p>
        <span class="more" style="color:#fff;font-weight:600;margin-top:auto">The first steps →</span>
      </a>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap stack" style="gap:24px">
      <div class="reveal" style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px">
        <div class="stack" style="gap:8px">
          <h2 class="h2">Plain language, three times a week</h2>
          <p style="color:var(--ink-2)">What I tell clients across the table, written down.</p>
        </div>
        <a href="/articles" style="font-weight:600">All articles →</a>
      </div>
      <div class="bento">
        {articles.map((a, i) => (
          <article class="block span-4 lift reveal stack" style={`--d:${i * 0.08}s;gap:12px`}>
            <p class="eyebrow">{topicLabel[a.topic] ?? a.topic}</p>
            <h3 style="font-size:24px;line-height:1.2">{a.title}</h3>
            <p class="muted" style="font-size:16px">{a.blurb}</p>
            {a.href ? <a href={a.href} style="font-weight:600;margin-top:auto">Read →</a> : <p class="muted small" style="margin-top:auto">Coming soon</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="block block-ink contact reveal" data-parrot-stop="contact" data-facts="contact">
        <div class="stack">
          <h2 class="h2">Phone me. It&rsquo;s still the fastest way.</h2>
          <p style="color:#C9D8CF">A first conversation costs nothing, and I&rsquo;ll tell you plainly whether you need me.</p>
          <div class="btn-row">
            <a class="btn btn-primary" href="/contact#callback">Ask me to call you</a>
            <a class="btn btn-ghost on-dark" href={whatsapp}>WhatsApp me</a>
          </div>
        </div>
        <div class="stack contact-facts" style="gap:8px">
          <p><strong>Phone</strong> <Fact value={site.phone} kind="phone" missing="Number" /></p>
          <p><strong>Email</strong> <Fact value={site.email} kind="email" missing="Address" /></p>
          <p><strong>Office</strong> {site.address}</p>
          <p><strong>Hours</strong> <Fact value={site.officeHours} missing="Hours" /></p>
          {linkedin && <p><strong>LinkedIn</strong> <a href={linkedin.href} target="_blank" rel="noopener me" style="color:#fff">Connect with me →</a></p>}
          <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`} target="_blank" rel="noopener" style="color:var(--moss);font-weight:600">Open in Google Maps →</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // The hero lioness yawns now and then; tapping her asks the lion guide to say something.
  const heroLion = document.querySelector<HTMLElement>('[data-lion-home]');
  if (heroLion && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const yawn = () => { const svg = heroLion.querySelector('.ln'); svg?.classList.add('is-yawning'); setTimeout(() => svg?.classList.remove('is-yawning'), 2400); setTimeout(yawn, 14000 + Math.random() * 12000); };
    setTimeout(yawn, 6000);
  }
  addEventListener('parrot-on-lion', (e) => {
    const el = (e as CustomEvent).detail?.el as Element | undefined;
    if (heroLion && el && heroLion.contains(el)) { const svg = heroLion.querySelector('.ln'); svg?.classList.add('is-yawning'); setTimeout(() => svg?.classList.remove('is-yawning'), 2200); }
  });
  heroLion?.addEventListener('click', () => dispatchEvent(new CustomEvent('lion-say', { detail: { el: heroLion } })));

  // The roots grow with scroll: progress through the pinned section draws each layer's roots and shows its cards.
  const sec = document.querySelector<HTMLElement>('.roots');
  const stage = sec?.querySelector<HTMLElement>('.roots-stage');
  const groups = Array.from(sec?.querySelectorAll<SVGGElement>('.roots-svg g[data-l]') ?? []);
  const tap = sec?.querySelector<SVGPathElement>('.root-tap');
  const bounds = [[0.10, 0.36], [0.38, 0.64], [0.66, 0.92]];
  let ticking = false;
  function update() {
    ticking = false;
    if (!sec || !stage) return;
    const r = sec.getBoundingClientRect();
    const span = sec.offsetHeight - innerHeight;
    const p = Math.min(1, Math.max(0, -r.top / span));
    let active = -1;
    bounds.forEach(([a, b], i) => {
      const k = Math.min(1, Math.max(0, (p - a) / (b - a - 0.06)));
      groups[i]?.querySelectorAll<SVGPathElement>('.root').forEach((path, j) => {
        const kk = Math.min(1, Math.max(0, k * 1.25 - j * 0.08));
        path.style.strokeDashoffset = String(1 - kk);
      });
      groups[i]?.querySelectorAll<SVGCircleElement>('.node').forEach((n, j) => n.classList.toggle('on', k * 1.25 - j * 0.08 > 0.95));
      if (p >= a - 0.02) active = i;
    });
    if (tap) tap.style.strokeDashoffset = String(1 - Math.min(1, p / 0.9));
    stage.dataset.active = String(active);
  }
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();
</script>

