# Copy to .env for local testing with `netlify dev`. NEVER commit .env.
# On Netlify: Site configuration > Environment variables.

# Supabase > Project settings > API keys (use the SECRET key, sb_secret_..., or the legacy service_role key)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # secret! server-side only, never in src/

# Must match compliance.privacyNoticeVersion in src/config/site.ts
PRIVACY_NOTICE_VERSION=2026-10-draft

# Optional, step 7 of docs/SETUP.md
MAILERLITE_API_KEY=
MAILERLITE_GROUP_REPORT=
MAILERLITE_GROUP_ARTICLES=
